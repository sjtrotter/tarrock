# --- Unity generated (machine-local; Unity rebuilds these from Assets/Packages) ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE solution/project files (generated per-machine)
*.csproj
# ...except the hand-authored shared library projects, which are source of truth
!shared/**/*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
.vs/
.idea/
.vscode/

# Unity crash/report artifacts
*.pidb.meta
sysinfo.txt
crashlytics-build.properties

# Addressables/build caches inside Assets that should not be versioned
unity/Assets/AddressableAssetsData/*/link.xml
unity/Assets/StreamingAssets/aa/

# --- Godot (godot/) ---
godot/.godot/

# --- Shared C# library build output (shared/) ---
# Redirected out of the Unity package folder by shared/Directory.Build.props.
shared/.artifacts/
shared/**/bin/
shared/**/obj/

# OS noise
.DS_Store
Thumbs.db
*~

# Local scratch
*.tmp
*.zip

# Screenshot tool output (test artifacts)
unity/Assets/Screenshots/
Screenshots/
*.blend1
unity/Assets/Screenshots.meta

# --- Secrets & machine-local state (never commit) ---
.env
.env.*
*.pem
*.key
!*.key.meta
id_rsa*
*.keystore
*.jks
auth.json
credentials*.json
serviceaccount*.json
# Claude/Codex session-local state — never commit; gauntlet reporting lives in docs/
.claude/
