[gd_resource type="Resource" script_class="SpreadRules" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/trumps/definitions/spread_rules.gd" id="1_spread_rules"]

[resource]
script = ExtResource("1_spread_rules")
id = &"SPREAD_RULES"
present_unlock_at_held = 1
past_unlock_at_held = 3
future_unlock_at_held = 7
fortune_max = 100
default_present_cost_upright = 30
default_present_cost_reversed = 20
favor_overfill = 25
favor_window_seconds = 6.0
favor_decay_per_second = 10.0
fortune_per_hit = 4
fortune_per_fools_chance = 25
fortune_per_discovery = 15
fortune_per_daring = 10
earn_multiplier_story = 1.5
earn_multiplier_journey = 1.0
earn_multiplier_trial = 0.7
rose_start_petals = 3
rose_max_petals = 8
rose_regrow_seconds_per_petal = 90.0
doc_ref = "docs/design/progression.md §The Pocket Spread, §Fortune, §The White Rose"
notes = "CANON: the 1/3/7 slot unlock pacing, the meter of roughly 100, the 3-petal start and 8-petal cap, and that reversed Present casts cost less than upright. TBD PLACEHOLDERS, set by nothing in docs/ and owned by the combat-tuning pass: default_present_cost_upright, default_present_cost_reversed, favor_overfill, favor_window_seconds, favor_decay_per_second, fortune_per_hit, fortune_per_fools_chance, fortune_per_discovery, fortune_per_daring, earn_multiplier_story, earn_multiplier_trial, rose_regrow_seconds_per_petal. The earn numbers are sized against combat.md's intent that a competent player reaches one Present cast per sustained fight. DECISION (round 6, TBD for the director): a grafting ARRIVES GROWN - taking one raises the capacity and hands over the petal with it, so the Rose the Fool finds is a flower rather than a promise of one. progression.md says only that graftings raise the maximum; it does not say whether the new petal is full or empty, and nothing in it settles the question. If the director prefers a grafting to raise the cap only, WhiteRoseService.add_grafting() drops its _set_petals() call and the test that pins the behaviour flips with it - no number here changes. NOTE (round 7, combat): fortune_per_daring is NOT paid for a dodge inside a fight. At these numbers a plain dodge would out-earn a landed hit, which would reward exactly the dodging early and often that combat.md builds Fool's Chance to NOT reward; in combat the perfect dodge's free Present cast is the whole reward. DARING keeps progression.md's other beats - near-misses and surviving high falls outside a fight - and CombatService.on_incoming_hit_dodged() says the same from the code side."
