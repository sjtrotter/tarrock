requires_any_trump_held = Array[StringName]([&"TRUMP_09", &"TRUMP_17"])
gates_entry_to = &"MIRRORMARSH"
notes = "§Layout: the Mere (WSW) and the Mirrormarsh (W) are neighbours on the wheel's rim, read clockwise from the north off the diagram. §Hard and soft gates: the Mirrormarsh's interior needs \"any true light: Hermit's Lantern, Star's Wish, or the Sun unbound\", and without one \"the region loops the player back out\". Modelled here as a refusal to enter - at region granularity the loop and the locked door are the same event. The gate guards ENTRY only: getting lost back out of the fog is what the fog does."

