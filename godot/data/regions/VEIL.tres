[gd_resource type="Resource" script_class="RegionDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/regions/definitions/region_definition.gd" id="1_region"]

[resource]
script = ExtResource("1_region")
id = &"VEIL"
card_number = 2
name_key = &"REGION_VEIL_NAME"
unbinding_flag = &"WS_PRIESTESS_UNBOUND"
difficulty_band = 3
summary = "A cloister-library in perpetual moonlit mist between two colossal pillars. Silent order of archivist nuns, plus a small lay staff of under-librarians (addressed as Brother or Sister by cloister courtesy, not vow); the world's secrets shelved and sealed. Stealth- and riddle-flavored."
scene_path = "res://scenes/regions/veil.tscn"
waystation_ids = Array[StringName]([&"WAYSTATION_VEIL"])
doc_ref = "docs/design/world.md §Regions"
