[gd_resource type="Resource" script_class="QuestGraph" load_steps=19 format=3]

[ext_resource type="Script" path="res://systems/quests/definitions/quest_graph.gd" id="1_graph"]
[ext_resource type="Script" path="res://systems/quests/definitions/quest_state.gd" id="2_state"]
[ext_resource type="Script" path="res://systems/quests/definitions/quest_transition.gd" id="3_transition"]

[sub_resource type="Resource" id="State_WAKING"]
script = ExtResource("2_state")
id = &"WAKING"
is_complete = false
notes = "EXT. THE CLIFF: The High Meadow — DAWN. The Fool wakes beside the dead campfire; the Bindle leans on a stone, still unclaimed."

[sub_resource type="Resource" id="State_BINDLE_TAKEN"]
script = ExtResource("2_state")
id = &"BINDLE_TAKEN"
is_complete = false
notes = "EXT. THE CLIFF: The High Meadow — DAWN. Tutorial prompt: pick up the Bindle. The Fool now owns everything the Fool owns."

[sub_resource type="Resource" id="State_KEEPSAKE_FOUND"]
script = ExtResource("2_state")
id = &"KEEPSAKE_FOUND"
is_complete = false
notes = "EXT. THE CLIFF: The Old Campsites — DAWN. Pip digs the whittled wooden dog out of the disturbed earth. Pip's Seek command is the Pip round (9); until then the dig site is an interaction."

[sub_resource type="Resource" id="State_DEAD_TREE_SEEN"]
script = ExtResource("2_state")
id = &"DEAD_TREE_SEEN"
is_complete = false
notes = "EXT. THE CLIFF: The Dead Tree — MORNING. Tutorial prompt: approach the dead tree. A beat, held, then the Querent on the one thing up here that dies."

[sub_resource type="Resource" id="State_AMBUSH_CLEARED"]
script = ExtResource("2_state")
id = &"AMBUSH_CLEARED"
is_complete = false
notes = "EXT. THE CLIFF: The Waystation Approach — MORNING. Three Blanks, Twos of Cups, Swords and Wands, fall in turn. Round 8 stands them in the Cliff scene: World/Encounters/WaystationAmbush raises MQ00_AMBUSH_CLEARED through the scene when all three are down. This edge is answered only from DEAD_TREE_SEEN because the graph is linear canon order; a player who clears the ambush first has the event latched by the scene and re-raised on arriving here."

[sub_resource type="Resource" id="State_RESTED"]
script = ExtResource("2_state")
id = &"RESTED"
is_complete = false
notes = "EXT. THE CLIFF: The First Waystation — MIDDAY. Tutorial prompt: rest at the Waystation. The Rose regrows entire; the Pocket Spread opens, and is empty."

[sub_resource type="Resource" id="State_EDGE_REACHED"]
script = ExtResource("2_state")
id = &"EDGE_REACHED"
is_complete = false
notes = "EXT. THE CLIFF: The Cliff's Edge — AFTERNOON. Tutorial prompt: approach the cliff's edge. The Querent's questions are dialogue, which is round 5."

[sub_resource type="Resource" id="State_COMPLETE"]
script = ExtResource("2_state")
id = &"COMPLETE"
is_complete = true
notes = "EXT. THE CLIFF: The Edge of the World — DUSK. Pip jumps first; the Fool steps off on purpose. MQ00 fires nothing: completing it opens the world by putting the Fool in it."

[sub_resource type="Resource" id="Transition_0_MQ00_BINDLE_TAKEN"]
script = ExtResource("3_transition")
